def message_body(state, account, mid, max_chars):
    snap = build(state)
    found = None
    for acct in snap["mail"]:
        if acct["id"] == account:
            for m in acct["messages"]:
                if m["id"] == mid:
                    found = m
    if found is None:
        # Read messages beyond the snapshot window still resolve, by fixture.
        for acct, (_p, _l, rows) in base_messages(state["started"]).items():
            for row in rows:
                if acct == account and row[0] == mid:
                    found = {"id": mid, "from": row[1], "subject": row[2], "received": row[3]}
    if found is None:
        return None, "no message %s in %s" % (mid, account)
    if account == "personal" and mid == "m4":
        return None, "fetching message bodies is not supported for this account yet"
    me = "toms@example.com" if account == "personal" else "toms@proton.me"
    if mid == "p3":
        text, links = NEWSLETTER, NEWSLETTER_LINKS
        to, cc = [me], []
    else:
        text = ("Hi Toms,\n\n%s.\n\nCould you have a look when you get a chance? The details are in the "
                "document linked below, and the meeting notes from last week are attached.\n\n"
                "Thanks,\n%s\n\n> On Tue, you wrote:\n> Sounds good, send it over." % (found["subject"], found["from"]))
        links = [{"text": "Shared document", "url": "https://docs.example.com/d/%s" % mid},
                 {"text": "https://mail.example.com/%s/%s" % (account, mid), "url": "https://mail.example.com/%s/%s" % (account, mid)}]
        to, cc = [me], (["team@example.com", "Ana Ruiz <ana@example.com>"] if mid in ("m1", "p1") else [])
    if max_chars and len(text) > max_chars:
        text = text[:max_chars] + "…"
    return {"type": "message", "id": mid, "from": found["from"] + " <%s@example.com>" % found["from"].split()[0].lower(),
            "to": to, "cc": cc, "date": found["received"], "subject": found["subject"], "text": text,
            "links": links}, None


EVENT_DETAILS = {
    "ev-soon": {"description": "Daily standup. Yesterday / today / blockers.\n\nJoin with Google Meet: meet.google.com/abc-defg-hij\nOr dial: +44 20 3937 0000 PIN: 123456789#",
                "organizer": "Ana Ruiz", "attendees": ["Toms Jansons", "Marcin Kowalski", "Lena Fischer", "priya@example.com",
                                                       "Daniel Okafor", "Sofia Marchetti", "Jonas", "Mara", "ferris@example.com", "Hetzner Bot"]},
    "ev-tomorrow": {"description": "Q4 planning: roadmap, hiring, budget. Bring your team's top three priorities.",
                    "organizer": "Ana Ruiz", "attendees": ["Toms Jansons", "Lena Fischer"]},
    "ev-later": {"description": None, "organizer": None, "attendees": []},
}


def event_details(state, eid):
    for event in build(state)["calendar"]:
        if event["id"] == eid:
            base = eid.rsplit("-", 1)[0] if eid.startswith(("ev-soon-", "ev-ongoing-")) else eid
            details = EVENT_DETAILS.get(base, {"description": "No agenda yet.", "organizer": "Toms Jansons", "attendees": []})
            return dict(event, type="event", details=details), None
    return None, "no upcoming event %s" % eid


def daemon_down():
    print("Error: herond is not running (no socket at %s/heron.sock)" % RUNTIME, file=sys.stderr)
    sys.exit(1)


def watch():
    if os.path.exists(DOWN):
        daemon_down()
    save_state(load_state())  # pins "started" for the arrivals below
    last = None
    while True:
        if os.path.exists(DOWN):
            return  # the daemon closed the connection
        line = json.dumps(build(load_state()), separators=(",", ":"))
        # Times inside the snapshot move every second; only re-emit on a real change.
        signature = json.dumps(json.loads(line)["mail"]) + json.dumps(json.loads(line)["discord"])
        if signature != last:
            print(line, flush=True)
            last = signature
        time.sleep(1)


def main(argv):
    with open(LOG, "a") as f:
        f.write("%s %s\n" % (time.strftime("%H:%M:%S"), " ".join(argv)))
    if not argv:
        print("usage: fake-heron watch|status --json|ack|mark-read|mark-unread|mark-seen|mark-unseen|"
              "message|event|reload", file=sys.stderr)
        return 2
    cmd, args = argv[0], argv[1:]
    if cmd == "watch":
        watch()
        return 0
    if os.path.exists(DOWN):
        daemon_down()
    state = load_state()
    if cmd == "status":
        print(json.dumps(build(state)))
    elif cmd == "ack":
        now = int(time.time())
        for account in ([args[0]] if args else ["personal", "proton"]):
            state["acked"][account] = now
    elif cmd in ("mark-read", "mark-unread") and len(args) == 2:
        key = args[0] + "/" + args[1]
        read, unread = set(state["read"]), set(state["unread"])
        if cmd == "mark-read":
            read.add(key)
            unread.discard(key)
        else:
            read.discard(key)
            unread.add(key)
        state["read"], state["unread"] = sorted(read), sorted(unread)
    elif cmd in ("mark-seen", "mark-unseen") and len(args) == 2:
        key = args[0] + "/" + args[1]
        seen, unseen = set(state.get("seen", [])), set(state.get("unseen", []))
        if cmd == "mark-seen":
            seen.add(key)
            unseen.discard(key)
        else:
            seen.discard(key)
            unseen.add(key)
        state["seen"], state["unseen"] = sorted(seen), sorted(unseen)
    elif cmd in ("message", "event"):
        positional, max_chars, i = [], 0, 0
        while i < len(args):
            if args[i] == "--max-chars" and i + 1 < len(args):
                max_chars = int(args[i + 1])
                i += 2
                continue
            if not args[i].startswith("--"):
                positional.append(args[i])
            i += 1
        time.sleep(0.4)  # a provider round trip, so the loading state shows
        if cmd == "message" and len(positional) == 2:
            reply, err = message_body(state, positional[0], positional[1], max_chars)
        elif cmd == "event" and len(positional) == 1:
            reply, err = event_details(state, positional[0])
        else:
            reply, err = None, "usage: %s" % cmd
        if err:
            print(json.dumps({"type": "error", "message": err}))
            return 1
        print(json.dumps(reply))
        return 0
    elif cmd == "reload":
        pass
    else:
        print("fake-heron: unsupported: %s" % " ".join(argv), file=sys.stderr)
        return 2
    save_state(state)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
