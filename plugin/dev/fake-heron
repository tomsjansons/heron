#!/usr/bin/env python3
# fake-heron: a stand-in for the `heron` CLI, for developing the Noctalia plugin
# without a running herond.
#
#   fake-heron watch                 snapshot now, then on every change
#   fake-heron status --json         one snapshot
#   fake-heron ack [account]         clear "new"
#   fake-heron mark-read ACCT ID     \
#   fake-heron mark-unread ACCT ID    | persisted in $XDG_RUNTIME_DIR/fake-heron.json,
#   fake-heron mark-seen ACCT ID      | so the plugin's actions round-trip
#   fake-heron mark-unseen ACCT ID   /
#   fake-heron message ACCT ID --json [--max-chars N]   one message body + links
#   fake-heron event ID --json       one calendar event with details
#   fake-heron reload                prints nothing, exits 0
#
# Every 20 seconds after the first run a new message arrives, five in total.
# Touch $XDG_RUNTIME_DIR/fake-heron.quiet to stop arrivals (and the desktop
# notifications they cause). Delete $XDG_RUNTIME_DIR/fake-heron.json to start over.
# `message personal m4` fails like an unsupported provider, to test errors.
# Touch $XDG_RUNTIME_DIR/fake-heron.big for 40 (or the number in it) busy Discord channels with
# full previews (a large snapshot, for checking the sync callback's CPU budget).
# Touch $XDG_RUNTIME_DIR/fake-heron.down to simulate a stopped daemon: running
# watches exit and new ones fail the way the real CLI does. Remove it to recover.
# Every invocation is logged to $XDG_RUNTIME_DIR/fake-heron.log (retry timing,
# which actions the plugin ran).
#
# Point the plugin at it without touching settings:
#   noctalia msg plugin toms/heron:sync all command "$PWD/plugin/dev/fake-heron"

import json
import os
import sys
import time

RUNTIME = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
STATE = os.path.join(RUNTIME, "fake-heron.json")
DOWN = os.path.join(RUNTIME, "fake-heron.down")
LOG = os.path.join(RUNTIME, "fake-heron.log")
QUIET = os.path.join(RUNTIME, "fake-heron.quiet")
BIG = os.path.join(RUNTIME, "fake-heron.big")
ARRIVAL_SECONDS = 20

ARRIVALS = [
    ("Ana Ruiz", "Q3 roadmap: final sign-off needed"),
    ("GitHub", "[heron] PR #12 ready for review"),
    ("Grafana Alerts", "Firing: api-latency-p99 above 800ms"),
    ("Lena Fischer", "Design handoff for the inbox panel"),
    ("Stripe", "Payout of EUR 4,120.00 is on the way"),
]


def load_state():
    try:
        with open(STATE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {"read": [], "unread": [], "seen": [], "unseen": [], "acked": {},
                "started": int(time.time())}


def save_state(state):
    tmp = STATE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(state, f)
    os.replace(tmp, STATE)


def base_messages(now):
    return {
        "personal": ("gmail", "home", [
            ("m1", "Marcin Kowalski", "Re: staging DB migration window", now - 25 * 60),
            ("m2", "Hetzner", "Server maintenance on 2026-10-30", now - 3 * 3600),
            ("m3", "Priya Nair", "Interview debrief: backend candidate", now - 26 * 3600),
            ("m4", "AWS Billing", "Your invoice for September is available", now - 4 * 86400),
        ]),
        "proton": ("proton", "proton", [
            ("p1", "Daniel Okafor", "Contract renewal, need your signature", now - 8 * 60),
            ("p2", "Sofia Marchetti", "Invoice #2291 attached", now - 5 * 3600),
            ("p3", "Rust Weekly", "This Week in Rust 571: async closures, cargo-script", now - 7 * 3600),
        ]),
    }


def build(state):
    now = int(time.time())
    accounts = base_messages(state["started"])
    # Messages that "arrived" while watching land in the proton account.
    arrived = min(len(ARRIVALS), max(0, (now - state["started"]) // ARRIVAL_SECONDS))
    if os.path.exists(QUIET):
        # Freeze arrivals at the moment the quiet file appeared.
        quiet_since = int(os.path.getmtime(QUIET))
        arrived = min(arrived, max(0, (quiet_since - state["started"]) // ARRIVAL_SECONDS))
    for i in range(arrived):
        sender, subject = ARRIVALS[i]
        received = state["started"] + (i + 1) * ARRIVAL_SECONDS
        accounts["proton"][2].insert(0, ("a%d" % i, sender, subject, received))

    read = set(state["read"])
    forced_unread = set(state["unread"])
    seen = set(state.get("seen", []))
    unseen = set(state.get("unseen", []))
    mail = []
    total_new = total_unread = 0
    for account, (provider, label, rows) in accounts.items():
        acked = state["acked"].get(account, state["started"] - 600)
        messages = []
        for mid, sender, subject, received in rows:
            key = account + "/" + mid
            unread = key not in read or key in forced_unread
            # "new": unread, and arrived after the ack and not marked seen, or
            # pinned by mark-unseen (which outlives an ack until marked seen).
            new = unread and ((received > acked and key not in seen) or key in unseen)
            messages.append({
                "id": mid, "from": sender, "subject": subject, "received": received,
                "unread": unread, "new": new,
                "url": "https://mail.example.com/%s/%s" % (account, mid),
            })
        messages.sort(key=lambda m: -m["received"])
        new = sum(1 for m in messages if m["new"])
        unread = sum(1 for m in messages if m["unread"])
        total_new += new
        total_unread += unread
        mail.append({"id": account, "label": label, "provider": provider, "new": new, "unread": unread,
                     "messages": [m for m in messages if m["unread"]] + [m for m in messages if not m["unread"]][:2]})

    lt = time.localtime(now)
    midnight = int(time.mktime((lt.tm_year, lt.tm_mon, lt.tm_mday, 0, 0, 0, 0, 0, -1)))
    started = state["started"]
    soon = started - started % 60 + 40 * 60  # outside the 10 minute reminder window
    calendar = [
        {"id": "ev-ongoing-%d" % started, "source": "personal", "calendar": "Work", "title": "Focus block",
         "location": None, "start": started - 20 * 60, "end": started + 5 * 60, "all_day": False,
         "color": "#7986cb", "url": "https://calendar.example.com/ev-ongoing"},
        {"id": "ev-soon-%d" % started, "source": "personal", "calendar": "Work", "title": "Standup",
         "location": None, "start": soon, "end": soon + 15 * 60, "all_day": False,
         "color": "#7986cb", "url": "https://calendar.example.com/ev-soon",
         "meeting_url": "https://meet.google.com/abc-defg-hij"},
        {"id": "ev-later", "source": "proton", "calendar": "Personal", "title": "Dentist",
         "location": "Brivibas iela 1, Riga", "start": started + 3 * 3600, "end": started + 4 * 3600,
         "all_day": False, "color": "#e67c73", "url": None},
        {"id": "ev-allday", "source": "personal", "calendar": "Birthdays", "title": "Jonas' birthday",
         "location": None, "start": midnight + 86400, "end": midnight + 2 * 86400, "all_day": True,
         "color": "#33b679", "url": None},
        {"id": "ev-tomorrow", "source": "personal", "calendar": "Work", "title": "Quarterly planning",
         "location": "Room 4", "start": midnight + 86400 + 10 * 3600, "end": midnight + 86400 + 12 * 3600,
         "all_day": False, "color": "#7986cb", "url": "https://calendar.example.com/ev-tomorrow",
         "meeting_url": "https://zoom.us/j/93812345678?pwd=abc"},
        {"id": "ev-week", "source": "proton", "calendar": "Personal", "title": "Flight to Berlin",
         "location": "RIX", "start": midnight + 3 * 86400 + 7 * 3600, "end": midnight + 3 * 86400 + 9 * 3600,
         "all_day": False, "color": "#e67c73", "url": None},
    ]
    calendar.sort(key=lambda e: e["start"])

    for event in calendar:
        event.setdefault("meeting_url", None)

    tick = (now - state["started"]) // ARRIVAL_SECONDS
    if os.path.exists(QUIET):
        tick = 1  # keep #announcements visible
    discord = build_discord(now, tick, state["started"])

    sources = [
        {"id": "personal", "kind": "gmail", "state": "ok", "message": None},
        {"id": "personal", "kind": "google_calendar", "state": "ok", "message": None},
        {"id": "proton", "kind": "proton_mail", "state": "ok", "message": None},
        {"id": "work", "kind": "gmail", "state": "needs_auth", "message": None},
        {"id": "proton", "kind": "proton_calendar", "state": "error", "message": "event loop: 503, retrying in 30s"},
        {"id": "discord", "kind": "discord", "state": "ok", "message": None},
    ]

    return {"type": "snapshot", "new": total_new, "unread": total_unread, "mail": mail,
            "calendar": calendar, "discord": discord, "sources": sources}


def dmsg(mid, author, content, ago, mentions_me=False):
    return {"id": mid, "author": author, "content": content, "timestamp": ago, "mentions_me": mentions_me}


def build_discord(now, tick, started):
    t = started
    channels = [
        {"id": "c1", "name": "general", "unread": 14, "more": False, "mentions": 2,
         "url": "https://discord.com/channels/1/c1", "messages": [
             dmsg("g1", "ferris", "anyone tried the new async closures on nightly?", t - 50 * 60),
             dmsg("g2", "Mara", "@toms can you look at the heron PR before lunch? it touches the plugin", t - 12 * 60, True),
             dmsg("g3", "Jonas", "@toms ping, the CI is red on main again [image]", t - 3 * 60, True),
         ]},
        {"id": "c2", "name": "heron-dev", "unread": 100, "more": True, "mentions": 0,
         "url": "https://discord.com/channels/1/c2", "messages": [
             dmsg("h1", "dependabot", "Bump tokio from 1.40 to 1.41", t - 2 * 3600),
             dmsg("h2", "Lena", "pushed the inbox panel design, screenshots in the thread " + "x" * 220, t - 90 * 60),
             dmsg("h3", "Ana", "lgtm", t - 30 * 60),
         ]},
        {"id": "c3", "name": "off-topic", "unread": 3, "more": False, "mentions": 0,
         "url": "https://discord.com/channels/1/c3", "messages": [
             dmsg("o1", "Priya", "", t - 5 * 3600),
             dmsg("o2", "Priya", "that was the wrong channel, sorry", t - 5 * 3600 + 30),
         ]},
    ]
    if tick % 2 == 1:
        channels.append({"id": "c4", "name": "announcements", "unread": 1, "more": False, "mentions": 1,
                         "url": "https://discord.com/channels/1/c4", "messages": [
                             dmsg("n1", "Mod Team", "@everyone meetup on Saturday, RSVP in #events", t - 20 * 60, True),
                         ]})
    if os.path.exists(BIG):
        # A busy server, for measuring the sync callback against its CPU budget.
        try:
            count = int(open(BIG).read().strip() or 40)
        except (OSError, ValueError):
            count = 40
        for n in range(count):
            channels.append({"id": "b%d" % n, "name": "busy-channel-%d" % n, "unread": 100, "more": True,
                             "mentions": n % 3, "url": "https://discord.com/channels/1/b%d" % n,
                             "messages": [dmsg("b%d-%d" % (n, k), "Someone %d" % k, ("lorem ipsum dolor sit amet " * 8)[:200],
                                               t - k * 60, k == 0) for k in range(3)]})
    channels.sort(key=lambda c: -c["mentions"])
    return {"id": "1", "name": "Rustaceans", "unread_channels": len(channels),
            "unread_messages": sum(c["unread"] for c in channels),
            "mentions": sum(c["mentions"] for c in channels), "channels": channels}


